{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  "packageRules": [
    {
      "matchDatasources": ["maven"],
      "matchPackagePatterns": [
        "^org\\.jetbrains\\.kotlin",
        "^org\\.jetbrains\\.compose",
        "^androidx\\.compose"
      ],
      "enabled": false
    }
  ]
  "labels": [
    "dependencies",
  ],
  "rebaseWhen": "conflicted"
}
